        d=a-b
        print(name,'max_abs=',float(np.max(np.abs(d))),
              'rms=',float(np.sqrt(np.mean(d*d))))
    print('argmax_cpp=',int(x[2].argmax()),
          'argmax_py=',int(y[2].argmax()),
          'agree=',bool(x[2].argmax()==y[2].argmax()))
PY

