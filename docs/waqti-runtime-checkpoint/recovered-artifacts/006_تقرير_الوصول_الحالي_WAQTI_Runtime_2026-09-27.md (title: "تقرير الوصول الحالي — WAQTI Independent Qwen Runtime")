import struct, numpy as np

def read(p):
    b=open(p,'rb').read(); n,h,v=struct.unpack_from('<III',b,0); o=12; out=[]
    for _ in range(n):
        a=np.frombuffer(b,dtype='<f4',count=h,offset=o).copy(); o+=4*h
        c=np.frombuffer(b,dtype='<f4',count=h,offset=o).copy(); o+=4*h
        z=np.frombuffer(b,dtype='<f4',count=v,offset=o).copy(); o+=4*v
        out.append((a,c,z))
    return out

cpp=read('/tmp/waqti_multitoken_cpp.bin')
